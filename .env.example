# Copy to .env. Every value here is a local-development default; there are
# no real credentials in this project because there are no external
# services to hold credentials for -- that is the point.

# --- profile ---------------------------------------------------------
# portable (default) is tuned for a machine with NO accelerator. Leave it
# alone on the Mac. Set accelerated on the Windows box with the NVIDIA GPU.
ENCLAVE_PROFILE=portable

# --- infrastructure --------------------------------------------------
# Ports are shifted off the defaults so they never collide with a local
# Postgres or Redis install.
ENCLAVE_DATABASE_URL=postgresql://enclave:enclave@127.0.0.1:5433/enclave
ENCLAVE_REDIS_URL=redis://127.0.0.1:6380/0
ENCLAVE_OLLAMA_URL=http://127.0.0.1:11434
# `enclave-local` turns this on automatically. Set it explicitly when running
# the lower-level `enclave-api` command in a production-like local session.
ENCLAVE_WARM_MODELS=0
ENCLAVE_UPLOAD_DIR=./data/uploads
ENCLAVE_MAX_UPLOAD_MB=20
# Login sessions are server-side and use an HttpOnly, SameSite=Strict cookie.
ENCLAVE_SESSION_HOURS=24
# Set to true only when the application is served over HTTPS.
ENCLAVE_COOKIE_SECURE=false
ENCLAVE_API_HOST=127.0.0.1
ENCLAVE_API_PORT=8000

# --- guarantee -------------------------------------------------------
# Refuse any model download at runtime; a cold cache becomes a loud
# failure instead of a silent network call. Keep this on.
ENCLAVE_OFFLINE_ONLY=1

# --- overrides (leave empty to use the profile default) --------------
# Set these only after Sprint 1 has MEASURED the knee on this machine.
# ENCLAVE_DEVICE=cpu
# ENCLAVE_RERANK_DEPTH=25
# ENCLAVE_EMBED_DIM=256          # must match vector(N) in sql/001_schema.sql
# ENCLAVE_MAX_PASSAGE_TOKENS=288
# ENCLAVE_CONDITIONAL_RERANK=true
# ENCLAVE_LLM_MODEL=qwen3:4b

# Where weights live. Point this at one directory so the native runtime
# and the release container share a cache.
HF_HOME=./.models
