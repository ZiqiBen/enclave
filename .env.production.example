# Copy to .env.production and keep that file out of Git.
ENCLAVE_DOMAIN=enclave.example.com
# Use URL-safe characters because this value is embedded in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-password
ENCLAVE_MODEL_CACHE=/srv/enclave/models
ENCLAVE_OLLAMA_URL=http://host.docker.internal:11434
ENCLAVE_SESSION_HOURS=24
